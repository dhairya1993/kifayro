# Kifayro Environment Configuration Template
# For ₹0-cost initial launch, defaults work out-of-the-box.
# No paid APIs or database connection strings are required.

# Public Deployment Base URL (Defaults to Vercel deployment URL if omitted)
# When deploying to Vercel, set this to your generated vercel.app URL (e.g. https://kifayro.vercel.app)
# After DNS connection to custom domain in the future, set to https://kifayro.com
NEXT_PUBLIC_SITE_URL=https://kifayro.vercel.app

# Environment Mode
NEXT_PUBLIC_ENVIRONMENT=production

# Future Affiliate Network Credentials (Optional - Not required for initial launch)
# AMAZON_ASSOCIATES_TAG=kifayro-21
# FLIPKART_AFFILIATE_ID=
# CUELINKS_PUB_ID=
